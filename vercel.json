{
  "services": {
    "app": {
      "root": ".",
      "runtime": "container",
      "entrypoint": "Dockerfile.vercel"
    },
    "auth": {
      "root": ".",
      "framework": "fastapi",
      "entrypoint": "auth.main:app",
      "installCommand": "pip install -r auth/requirements.txt",
      "bindings": [
        {
          "type": "service",
          "service": "app",
          "format": "url",
          "env": "APP_URL"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/auth/(.*)",
      "destination": {
        "service": "auth"
      }
    },
    {
      "source": "/users/(.*)",
      "destination": {
        "service": "auth"
      }
    },
    {
      "source": "/health",
      "destination": {
        "service": "auth"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
