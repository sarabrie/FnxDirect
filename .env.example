GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
FIRE_CRAWL_API_KEY=

# Auth — generate with: python -c "import secrets; print(secrets.token_hex(48))"
JWT_SECRET=

# Google OAuth (optional) — create at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8501

# Optional: override SQLite path (default: auth.sqlite3 next to app.py)
# AUTH_DB_PATH=/data/auth.sqlite3
