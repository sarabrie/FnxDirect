GEMINI_API_KEY=
# Extra keys, comma-separated. When one key's daily quota runs out, the next one is used.
# Quota is per Google Cloud project — create each key in a different project.
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-3.8-flash
FIRE_CRAWL_API_KEY=

# Auth — generate with: python -c "import secrets; print(secrets.token_hex(48))"
JWT_SECRET=

# Google OAuth (optional) — create at https://console.cloud.google.com/apis/credentials
BASE_URL=http://localhost:8501
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Optional override; defaults to BASE_URL/auth/google/callback
GOOGLE_REDIRECT_URI=

# Optional admin panel password
ADMIN_SECRET=

# Optional: override SQLite path (default: auth.sqlite3 next to app.py)
# AUTH_DB_PATH=/data/auth.sqlite3
DATABASE_URL=postgresql://neondb_owner:npg_jFArV2HgBUe1@ep-empty-mountain-b4hs73pk-pooler.c-6.us-east-2.aws.neon.tech/neondb?sslmode=require
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

