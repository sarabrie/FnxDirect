# ── Gemini ───────────────────────────────────────────────────────────────────
GEMINI_API_KEY=
# Extra keys, comma-separated. When one key's daily quota runs out, the next one is used.
# Quota is per Google Cloud project — create each key in a different project.
GEMINI_API_KEYS=
# Optional: models to try, in order (comma-separated).
# GEMINI_MODELS=gemini-3.8-flash,gemini-3.5-flash,gemini-3-flash-preview,gemini-3.6-flash

# ── Website crawling (only for `python -m fnx_direct.knowledge.ingest`) ──────
FIRE_CRAWL_API_KEY=

# ── Auth ─────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(48))"
JWT_SECRET=

# ── Google OAuth (optional) — https://console.cloud.google.com/apis/credentials
BASE_URL=http://localhost:8501
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional override; defaults to BASE_URL/auth_google_callback
GOOGLE_REDIRECT_URI=

# ── Admin panel (/admin) password (optional) ─────────────────────────────────
ADMIN_SECRET=

# ── Optional: SQLite locations (default: data/ in the project) ───────────────
# CHAT_HISTORY_DB_PATH=/data/chat_history.sqlite3
# AUTH_DB_PATH=/data/auth.sqlite3

# ── Dev only: skip HTTPS certificate checks (corporate proxies). Never in production.
# DISABLE_SSL_VERIFY=1
